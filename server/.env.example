# Copy to .env and fill in (never commit .env)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/aasha_sm?retryWrites=true&w=majority

# Purge database: must match the database name in URI above
# CONFIRM_RESET_DB=aasha_sm

# If URI uses carbook, only AASHA collections (not full DB):
# CONFIRM_RESET_DB=carbook
# DELETE_AASHA_COLLECTIONS_ON_CARBOOK=true

# Drop all collections in the URI database EXCEPT contact_submissions (lead form):
# CONFIRM_PURGE_KEEP_CONTACT_SUBMISSIONS=carbook   # must match DB name in URI

PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production
